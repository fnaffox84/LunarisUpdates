# Port the bridge listens on locally.
PORT=8787

# Random long token you invent yourself. Required on every request via
# "Authorization: Bearer <BRIDGE_TOKEN>". Never commit the real value.
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Roblox Open Cloud API key, from https://create.roblox.com/dashboard/credentials
ROBLOX_API_KEY=

# Your Roblox universe/place IDs, for the Open Cloud endpoints.
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Full path to Roblox Studio's mcp.bat (Windows only), used by the /mcp routes.
# Typically: C:\Users\<you>\AppData\Local\Roblox\mcp.bat
STUDIO_MCP_BAT=%LOCALAPPDATA%\Roblox\mcp.bat
